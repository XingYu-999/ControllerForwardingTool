<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControllerForwardingTool.ViewModels"
        xmlns:views="using:ControllerForwardingTool.Views"
        xmlns:app="using:ControllerForwardingTool"
        x:Class="ControllerForwardingTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1400" Height="860" MinWidth="1050" MinHeight="680"
        Background="{StaticResource Canvas}"
        Icon="/Assets/ControllerForwardingTool.ico"
        Title="{x:Static app:AppIdentity.ChineseName}" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="64,*">
    <Border Grid.RowSpan="2" Width="{Binding NavigationWidth}" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto" Margin="10,0">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,10,0,0">
          <Button Classes="nav" Classes.selected="{Binding IsOverview}" Command="{Binding NavigateCommand}" CommandParameter="概览" ToolTip.Tip="概览" AutomationProperties.Name="概览">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE80F;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="概览" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsBluetooth}" Command="{Binding NavigateCommand}" CommandParameter="NS2 Pro 连接" ToolTip.Tip="NS2 Pro 连接" AutomationProperties.Name="NS2 Pro 连接">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Width="24" Height="24" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Data="M 7,10 C 3,10 2,13 1,19 C 0,23 3,24 6,20 L 18,20 C 21,24 24,23 23,19 C 22,13 21,10 17,10 Z M 5,14 V 19 M 2.5,16.5 H 7.5 M 17,14 H 18 M 20,17 H 21 M 6,4 Q 12,-1 18,4 M 9,7 Q 12,4 15,7" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="NS2 Pro 连接" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsTesterSection}" Command="{Binding NavigateCommand}" CommandParameter="手柄测试" ToolTip.Tip="手柄测试" AutomationProperties.Name="手柄测试">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE7FC;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="手柄测试" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsVirtual}" Command="{Binding NavigateCommand}" CommandParameter="虚拟手柄" ToolTip.Tip="虚拟手柄" AutomationProperties.Name="虚拟手柄">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Width="24" Height="24" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Data="M 2,2 H 22 V 16 H 19 M 5,16 H 2 Z M 9,12 C 6,12 5,15 4,21 C 4,24 6,25 9,21 H 17 C 20,25 22,24 22,21 C 21,15 20,12 17,12 Z M 8,15 V 20 M 5.5,17.5 H 10.5 M 17,15 H 18 M 19,18 H 20" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="虚拟手柄" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsMapping}" Command="{Binding OpenMappingPreviewCommand}" ToolTip.Tip="按键映射" AutomationProperties.Name="按键映射">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Width="24" Height="24" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" Data="M 2,3 H 8 V 9 H 2 Z M 16,15 H 22 V 21 H 16 Z M 11,6 H 19 V 11 M 16,8 L 19,11 L 22,8 M 13,18 H 5 V 13 M 2,16 L 5,13 L 8,16" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="按键映射" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsLogs}" Command="{Binding NavigateCommand}" CommandParameter="日志" ToolTip.Tip="日志" AutomationProperties.Name="日志">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE9D9;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="日志" Classes="navLabel" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,16">
          <Border Height="1" Background="{StaticResource ShellBorder}" Margin="10,0,10,10" />
          <Button Classes="nav" Classes.selected="{Binding IsChangelog}" Command="{Binding NavigateCommand}" CommandParameter="更新日志" ToolTip.Tip="更新日志" AutomationProperties.Name="更新日志">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE81C;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="更新日志" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="设置" ToolTip.Tip="设置" AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE713;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="设置" Classes="navLabel" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsAbout}" Command="{Binding NavigateCommand}" CommandParameter="关于" ToolTip.Tip="关于" AutomationProperties.Name="关于">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="&#xE946;" Classes="navIcon" /><TextBlock IsVisible="{Binding IsNavigationExpanded}" Text="关于" Classes="navLabel" /></StackPanel>
          </Button>
          <Button IsVisible="{Binding IsNavigationExpanded}" Classes="nav" Command="{Binding ToggleNavigationCommand}" ToolTip.Tip="收起导航" AutomationProperties.Name="收起导航">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Width="22" Height="22" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="M 10,5 L 4,11 L 10,17 M 18,5 L 12,11 L 18,17" />
              <TextBlock Text="收起导航" Classes="navLabel" />
            </StackPanel>
          </Button>
          <Button IsVisible="{Binding !IsNavigationExpanded}" Classes="nav" Command="{Binding ToggleNavigationCommand}" ToolTip.Tip="展开导航" AutomationProperties.Name="展开导航">
            <Path Width="22" Height="22" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="M 4,5 L 10,11 L 4,17 M 12,5 L 18,11 L 12,17" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="24,0">
        <TextBlock Grid.Column="0" Text="{Binding SelectedPage}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ConnectionStatusLabel}" ToolTip.Tip="{Binding ControllerStage}" FontSize="13"
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button Grid.Column="2" Content="打开日志" Command="{Binding NavigateCommand}" CommandParameter="日志"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="MainContentScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="20">
        <views:OverviewPage IsVisible="{Binding IsOverview}" />
        <views:GyroCalibrationPage IsVisible="{Binding IsGyroCalibration}" />
        <views:MappingPage IsVisible="{Binding IsMapping}" />

        <StackPanel IsVisible="{Binding IsBluetooth}" Spacing="14">
          <StackPanel Spacing="5">
            <TextBlock Classes="title" Text="NS2 Pro 连接" />
            <TextBlock Classes="muted" Text="候选名称和厂商字段只能用于筛选；收到有效 FD2 输入后才确认输入正常。" />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="扫描与连接" />
              <TextBlock Text="{Binding AdapterState}" Classes="muted" />
              <TextBlock Text="{Binding Ns2BatteryText}" IsVisible="{Binding IsConnected}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ControllerStage}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
              <ToggleSwitch Content="自动连接（默认开启）" IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
              <ToggleSwitch Content="将电脑注册到手柄（默认关闭）" IsChecked="{Binding RegisterHostOnSync, Mode=TwoWay}" IsEnabled="{Binding CanChangeRegistration}" />
              <TextBlock Classes="muted" Text="开启后，下次 SYNC 连接会把电脑注册到手柄，切回 NS2 可能需要重新配对。关闭不会撤销已有注册，也不影响已注册手柄回连。设置自动保存，连接过程中不可更改。" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding RegistrationSettingsStatus}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="扫描手柄" Command="{Binding ScanCommand}" />
                  <Button Content="停止搜索 / 连接" Command="{Binding StopScanCommand}" IsEnabled="{Binding CanStopConnecting}" />
                  <Button Content="{Binding ConnectActionText}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
                <Button Content="断开连接" Command="{Binding DisconnectCommand}"  />
              </StackPanel>
              <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" MinHeight="120" MaxHeight="260">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" Margin="8,6" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
                <TextBlock Classes="muted" Text="未连接设备在约 6 秒没有新广播后移出扫描列表；已连接过的手柄记录会保留。" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="首次请长按顶部 SYNC；自动连接开启时会自动连接。只有开启“将电脑注册到手柄”才会写入注册信息；已注册的手柄可直接尝试普通按键唤醒。" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="已连接过的手柄" />
              <TextBlock Classes="muted" Text="{Binding RememberedDevicesStatus}" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding RememberedDevices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,4">
                          <TextBlock Text="{Binding Summary}" Margin="8,6" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="删除" VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].DataContext.ForgetRememberedDeviceCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="删除记录和名称、断开连接并取消 Windows 配对" />
                          <Button Grid.Column="2" Content="重命名" VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].DataContext.BeginRenameRememberedDeviceCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Spacing="8" IsVisible="{Binding IsRenamingDevice}">
                  <TextBlock Text="{Binding RenameDeviceTitle}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding RememberedAliasDraft, Mode=TwoWay}" PlaceholderText="输入此手柄的名称" MaxLength="40" />
                    <Button Grid.Column="1" Content="保存名称" Command="{Binding SaveRememberedDeviceNameCommand}" />
                    <Button Grid.Column="2" Content="取消" Command="{Binding CancelRenameRememberedDeviceCommand}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding RememberedAliasStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="muted" Text="删除会清除该手柄的记录和名称、断开连接并取消 Windows 配对。再次使用请长按顶部 SYNC；开启自动连接时会自动连接，关闭时可手动重新配对。" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="实时输入预览" />
              <TextBlock Classes="muted" Text="{Binding BleConnectionTiming}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ControllerStateText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="{Binding LastInputText}" Classes="muted" />
              <TextBlock Text="{Binding FramesText}" Classes="muted" />
              <TextBlock Text="{Binding ButtonsText}" Classes="muted" />
              <TextBlock Text="{Binding SticksText}" Classes="muted" />
              <TextBlock Text="{Binding ImuText}" Classes="muted" />
              <TextBlock Classes="muted" Text="摇杆和 IMU 当前显示原始值；方向、单位与校准需实机验证。" />
            </StackPanel>
          </Border>
          <Expander Header="诊断详情：最新原始 FD2 报文">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="仅保留最新报文，最多展示 80 字节；初始化命令和 ACK 记录在日志页。" />
                <TextBox Text="{Binding RawSampleText}" IsReadOnly="True" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>

        <views:TesterPage IsVisible="{Binding IsTester}" />

        <views:VirtualPage IsVisible="{Binding IsVirtual}" />

        <StackPanel IsVisible="{Binding IsLogs}" Spacing="14">
          <TextBlock Classes="title" Text="日志" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="muted" Text="界面显示最近 200 条阶段与错误；完整运行日志自动保存在用户日志目录，可在设置页打开。" />
              <ItemsControl ItemsSource="{Binding Logs}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <views:SettingsPage IsVisible="{Binding IsSettings}" />
        <views:ChangelogPage IsVisible="{Binding IsChangelog}" />

        <Border IsVisible="{Binding IsAbout}"><views:AboutPage /></Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
